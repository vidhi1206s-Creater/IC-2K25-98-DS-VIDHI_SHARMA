PROGRAM04:Addition of Two Matrices.

#include<iostream.h>
#include<conio.h>
void main()
{
    clrscr();
    int a[10][10], b[10][10], sum[10][10];
    int r, c, i, j;

    cout<<"Enter rows and columns: ";
    cin>>r>>c;

    if(r<1 || r>10 || c<1 || c>10)
    {
        cout<<"Invalid matrix size";
        getch();
        return;
        cout<<"Enter first matrix:\n";
   for(i=0; i<r; i++)
        for(j=0; j<c; j++)
            cin>>a[i][j];

    cout<<"Enter second matrix:\n";

    for(i=0; i<r; i++)
        for(j=0; j<c; j++)
            cin>>b[i][j];

    for(i=0; i<r; i++)
    {
        for(j=0; j<c; j++)
        {
            sum[i][j]=a[i][j]+b[i][j];
        }
    }
    cout<<"\nSum of two matrices:\n";

    for(i=0; i<r; i++)
    {
        for(j=0; j<c; j++)
            cout<<sum[i][j]<<"\t";
        cout<<"\n";
    }
    getch();
}

