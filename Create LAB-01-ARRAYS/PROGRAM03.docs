PROGRAM03.Linear Search in an Array

#include<iostream.h>
#include<conio.h>

void main()
{
    clrscr();

    int arr[100], n, i, key, found=0;

    cout<<"Enter number of elements: ";
    cin>>n;

    cout<<"Enter array elements:\n";

    for(i=0; i<n; i++)
        cin>>arr[i];

    cout<<"Enter element to search: ";
    cin>>key;

    for(i=0; i<n; i++)
    {
        if(arr[i]==key)
        {
            cout<<"Element found at position "<<i+1;
            found=1;
            break;
        }
    }

    if(found==0)
        cout<<"Element not found";

    getch();
}

