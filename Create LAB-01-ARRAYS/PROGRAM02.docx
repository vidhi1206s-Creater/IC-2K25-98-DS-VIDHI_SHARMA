PROGRAM02.Insertion in an Array.

#include<iostream.h>
#include<conio.h>

void main()
{
    int arr[100], n, i, pos, value;
    clrscr();
   cout<<"Enter number of elements: ";
    cin>>n;

    if(n<0 || n>=100)
    {
        cout<<"Invalid array size";
        getch();
        return;
    }
    cout<<"Enter array elements:\n";

    for(i=0; i<n; i++)
    {
        cin>>arr[i];
    }
    cout<<"Enter position: ";
    cin>>pos;
    cout<<"Enter value: ";
    cin>>value;

    if(pos<1 || pos>n+1)
    {
        cout<<"Invalid position";
    }
    else
    {
        for(i=n; i>=pos; i--)
        {
            arr[i]=arr[i-1];
        }

        arr[pos-1]=value;
        n++;

        cout<<"\nArray after insertion:\n";

        for(i=0; i<n; i++)
        {
            cout<<arr[i]<<" ";
        }
    }

    getch();
}
}

