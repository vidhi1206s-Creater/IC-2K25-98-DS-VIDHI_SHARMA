PROGRAM06.BINARY SEARCH

include <iostream>
using namespace std;
int main()
{
    int arr[100], n, key;
    int lb,ub, mid;
    int found = 0;
   cout << "Enter number of elements: ";
    cin >> n;
   cout << "Enter elements in ascending order: ";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
   cout << "Enter element to search: ";
    cin >> key;
   lb = 0;
    ub = n - 1;
    while (lb <= ub)
    {
        mid = (lb + ub) / 2;
      if (arr[mid] == key)
        {
            cout << "Element found at position " << mid + 1;
            found = 1;
            break;
        }
        else if (arr[mid] < key)
        {
            lb = mid + 1;
        }
        else
        {
            ub = mid - 1;
        }
    }
    if (found == 0)
    {
        cout << "Element not found";
    }
    return 0;
}

