Program5 .Linear Search

#include <iostream>
using namespace std;

int main()
{
int arr[100], n, num;
int i, found = 0;

cout << "Enter the number of elements: ";
cin >> n;

cout << "Enter array elements: ";

for(int i = 0; i < n; i++)
{
    cin >> arr[i];
}

cout << "\nArray elements are:\n";

for(int i = 0; i < n; i++)
{
    cout << arr[i] << " ";
}

cout << "\nEnter the element to search: ";
cin >> num;

for(i = 0; i < n; i++)
{
    if(arr[i] == num)
    {
        cout << "Element found at position " << i + 1;
        found = 1;
        break;
    }
}

if(found == 0)
{
    cout << "Element not found";
}

return 0;

}
